import { gelatoApiKey } from "../../../../../lib/constants";
import { NextResponse } from "next/server";

export const revalidate = 0;

export async function GET(req, { params }) {
  const { productUid } = params;
  console.log("🚀 ~ GET ~ productUid:", productUid);

  if (!productUid) {
    return new NextResponse(JSON.stringify({ error: "Missing product UID" }), {
      status: 400,
    });
  }

  try {
    const response = await fetch(
      `https://product.gelatoapis.com/v3/products/canvas_300x450-mm-12x18-inch_canvas_wood-fsc-slim_4-0_ver/prices`,
      {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
          "X-API-KEY": gelatoApiKey,
        },
      }
    );
    console.log("🚀 ~ GET ~ response:", response);

    if (!response.ok) {
      console.error(
        "Price fetch failed:",
        response.status,
        await response.text()
      );
      return new NextResponse(
        JSON.stringify({ error: "Failed to fetch prices" }),
        { status: response.status }
      );
    }

    const prices = await response.json();
    return new NextResponse(JSON.stringify(prices), {
      status: 200,
      headers: { "Content-Type": "application/json" },
    });
  } catch (error) {
    console.error("🚀 ~ GET ~ error:", error);
    return new NextResponse(
      JSON.stringify({ error: "Internal Server Error" }),
      { status: 500 }
    );
  }
}
