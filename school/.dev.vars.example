# Copy to .dev.vars for local development (never commit .dev.vars). In production, set these as
ADMIN_EMAILS=carlosreinosopastas@gmail.com   # your account runs the school (comma-separate several)
# encrypted variables: Cloudflare dashboard → Workers & Pages → carlos-school → Settings → Variables and Secrets.
DEV_UNLOCK=1                 # local only: show the e-mail login code on screen instead of sending it
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...    # a recurring monthly Price (or a one-time Price with STRIPE_MODE=payment)
STRIPE_WEBHOOK_SECRET=whsec_...
